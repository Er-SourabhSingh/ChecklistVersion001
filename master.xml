<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="All Test Suite">
    <listeners>
        <listener class-name="utilities.ExtentReportManager"/>
    </listeners>

    <test thread-count="5" name="Checklist test">
        <parameter name="os" value="window"/>
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="testClasses.TC001_VerifyChecklistPluginInstallatio"/>
            <class name="testClasses.TC002_VerifyChecklistBlockClosingWhenDisabled"/>
            <class name="testClasses.TC003_VerifyChecklistBlockClosingWhenEnabled"/>
            <class name="testClasses.TC004_VerifyCRUDOperationsWithEditIssuePermission"/>
            <class name="testClasses.TC005_VerifyChecklistNotCreatedWithoutEditPermission"/>
            <class name="testClasses.TC006_VerifyChecklistNotEditableAfterIssueClosed"/>
            <class name="testClasses.TC007_VerifyProgressBarUpdateOnChecklistSelectionChange"/>
            <class name="testClasses.TC008_VerifyChecklistTemplateCreationAndUsage"/>
        </classes>
    </test>
</suite>